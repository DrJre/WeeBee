# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ID of the channel where cards will drop
DISCORD_CHANNEL_ID=

# Destination channels for /announce (pick via the destination option)
ANNOUNCEMENTS_CHANNEL_ID=
EVENTS_CHANNEL_ID=
GIVEAWAYS_CHANNEL_ID=

# Firebase service account JSON, base64-encoded
# Run: node -e "console.log(Buffer.from(require('fs').readFileSync('./service-account.json')).toString('base64'))"
# Then paste the output here
FIREBASE_SERVICE_ACCOUNT=
