{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "CLAUDE.md",
      "firebase-debug.log"
    ],
    "redirects": [
      { "source": "/", "destination": "/maintenance.html", "type": 302 },
      { "source": "/index.html", "destination": "/maintenance.html", "type": 302 }
    ],
    "rewrites": [
      { "source": "**", "destination": "/maintenance.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
