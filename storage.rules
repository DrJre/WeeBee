rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars — owner write, public read
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Banners — owner write, public read
    match /banners/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Post images — owner write, public read
    match /post_images/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Cursors — public read only
    match /cursors/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

  }
}
