rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() { return isAuth() && request.auth.uid == 'XUD3ym2NcdWtrUiPLlFFaO5ufMh1'; }

    // ── Reviews ───────────────────────────────────────────────────────────────
    match /reviews/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow delete: if isOwner(resource.data.uid) || isAdmin();
      // Owner can edit anything; other signed-in users can only toggle
      // their own like/dislike reaction.
      allow update: if isOwner(resource.data.uid) || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
      );
    }

    // ── Community content (likes/votes require update by any auth user) ───────
    match /tier_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    match /hot_takes/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /polls/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /brackets/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /bracket_templates/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /bw_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /bw_op_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    // ── BuzzWord game records & leaderboards ──────────────────────────────────
    match /bw_op_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      // Doc id is `{uid}_{YYYY-MM-DD}` — ownership is derived from the id
      // itself so a write isn't blocked if an earlier save (before this
      // doc had a `uid` field) created it without one.
      allow update: if isAuth() && doc.split('_')[0] == request.auth.uid;
    }
    match /bw_op_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_nrt_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      // Doc id is `{uid}_{YYYY-MM-DD}` — ownership is derived from the id
      // itself so a write isn't blocked if an earlier save (before this
      // doc had a `uid` field) created it without one.
      allow update: if isAuth() && doc.split('_')[0] == request.auth.uid;
    }
    match /bw_nrt_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_blc_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      // Doc id is `{uid}_{YYYY-MM-DD}` — ownership is derived from the id
      // itself so a write isn't blocked if an earlier save (before this
      // doc had a `uid` field) created it without one.
      allow update: if isAuth() && doc.split('_')[0] == request.auth.uid;
    }
    match /bw_blc_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_db_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      // Doc id is `{uid}_{YYYY-MM-DD}` — ownership is derived from the id
      // itself so a write isn't blocked if an earlier save (before this
      // doc had a `uid` field) created it without one.
      allow update: if isAuth() && doc.split('_')[0] == request.auth.uid;
    }
    match /bw_db_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /trivia_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /general_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    // ── Custom / Shared Lists ─────────────────────────────────────────────────
    match /custom_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      // Members can edit; anyone auth can join (their uid appears in new memberUids)
      allow update: if isAuth() && (
        resource.data.memberUids.hasAny([request.auth.uid]) ||
        request.resource.data.memberUids.hasAny([request.auth.uid])
      );
      allow delete: if isOwner(resource.data.uid);
    }

    match /melobee_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    // ── TCG Dungeon raid result shares ────────────────────────────────────────
    match /dungeon_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /patch_notes/{doc} {
      allow read: if true;
      // Posting/deleting official patch notes is admin-only (UI is gated by
      // window.isAdmin, but that's client-side only — enforce here too).
      // Likes/dislikes are toggled by any signed-in user via update.
      allow create, delete: if isAdmin();
      allow update: if isAuth();
    }

    // ── Comments ──────────────────────────────────────────────────────────────
    match /bw_post_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow delete: if isOwner(resource.data.uid);
      allow update: if isOwner(resource.data.uid) || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
      );
    }

    match /episode_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow delete: if isOwner(resource.data.uid);
      // Owner can edit anything; other signed-in users can only toggle
      // their own like/dislike reaction.
      allow update: if isOwner(resource.data.uid) || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
      );
    }

    match /profile_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Profiles ──────────────────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      // Owner can update their own profile (display name, bio, avatar, etc.),
      // but privileged numeric fields (currency, rank counters) can only move
      // by bounded amounts per write. Amber may be spent freely (only capped
      // at 0 — can't go negative) but can only increase by ≤ 2000 per write
      // (matches the largest single award: UR dismantle = 1500 amber). The
      // +1 caps on counters prevent bulk-inflating rank stats.
      //
      // Non-owners may increment amber only (positive direction, ≤ 50000 per
      // write). This covers auction bid refunds: when you're outbid, the new
      // bidder's transaction writes an amber refund back to your profile.
      // Cloud Functions aren't available yet, so this is the client-side path.
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('amber', 0) >= 0 &&
        request.resource.data.get('amber', 0) <= resource.data.get('amber', 0) + 2000 &&
        request.resource.data.get('reviewCount', 0)    <= resource.data.get('reviewCount', 0) + 1 &&
        request.resource.data.get('indepthCount', 0)   <= resource.data.get('indepthCount', 0) + 1 &&
        request.resource.data.get('completedCount', 0) <= resource.data.get('completedCount', 0) + 1 &&
        request.resource.data.get('reactionCount', 0)  <= resource.data.get('reactionCount', 0) + 1 &&
        request.resource.data.get('loginStreak', 0)    <= resource.data.get('loginStreak', 0) + 1
      ) || (
        isAuth() &&
        !isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amber']) &&
        request.resource.data.get('amber', 0) >= resource.data.get('amber', 0) &&
        request.resource.data.get('amber', 0) <= resource.data.get('amber', 0) + 50000
      );
    }

    // ── Anime lists & top lists ───────────────────────────────────────────────
    match /anime_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /top_anime_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Social (follows, friends, DMs) ───────────────────────────────────────
    match /follows/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /friends/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /friend_requests/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /conversations/{doc} {
      allow read: if isAuth() && (resource.data.participants[request.auth.uid] == true);
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.participants[request.auth.uid] == true);

      match /messages/{msg} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isOwner(resource.data.uid);
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{doc} {
      allow read: if isOwner(resource.data.targetUid);
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    // ── Achievements & ranks ──────────────────────────────────────────────────
    match /achievements/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /rankHistory/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Seasonal voting ───────────────────────────────────────────────────────
    match /seasonal_votes/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /seasonal_vote_records/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /seasonal_winners/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /seasonal_badges/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Cache & character DB ──────────────────────────────────────────────────
    match /anime_cache/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /characters/{doc} {
      allow read: if true;
      // Tier-list character search auto-caches new AniList results for any
      // signed-in user (always a brand-new doc), but editing or deleting
      // existing card art/rarities (TCG admin tools) is admin-only.
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ── Feedback ──────────────────────────────────────────────────────────────
    match /bug_reports/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /feature_suggestions/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /direct_suggestions/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── Amber currency log ───────────────────────────────────────────────────
    match /amber_log/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── TCG card collections (per-user subcollection) ─────────────────────────
    // collectionGroup('cards') — used by the public versions page and admin tools.
    match /{path=**}/cards/{card} {
      allow read: if true;
    }
    match /card_collections/{uid}/cards/{card} {
      allow read: if true;
      // Admin can also create cards directly in another user's collection —
      // used to gift the 1-of-1 Founder edition card.
      // Monthly Prize Wheel UR cards are special-cased: the owner can only
      // create one if their wheel_state shows they actually landed on the
      // UR slot this spin (pendingUrClaim == true) — prevents writing a
      // fake monthly UR directly.
      allow create: if isAdmin() || (
        isOwner(uid) && (
          request.resource.data.get('monthlyUr', false) != true ||
          get(/databases/$(database)/documents/wheel_state/$(uid)).data.pendingUrClaim == true
        )
      );
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Prize Wheel ────────────────────────────────────────────────────────
    // Admin-managed config: this month's UR card art/name + enabled toggle.
    match /wheel_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-user wheel state. `sections` (the shuffled reward layout for the
    // month) and `month` are immutable once created — only `usedIndices`,
    // `lastSpinDate`, `extraSpinsAvailable`, and `pendingUrClaim` may change,
    // and at most one new section may be claimed per write.
    match /wheel_state/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      // Admin can freely update any wheel_state (for testing tools).
      // Owner updates: either just toggling pendingUrClaim (UR gate flag),
      // or a regular spin update where sections/month are unchanged,
      // usedIndices grows by at most 1, and lastSpinDate never goes back.
      allow update: if isAdmin() || (isOwner(uid) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingUrClaim']) ||
        (
          request.resource.data.sections == resource.data.sections &&
          request.resource.data.month == resource.data.month &&
          request.resource.data.usedIndices.size() <= resource.data.usedIndices.size() + 1 &&
          request.resource.data.lastSpinDate >= resource.data.lastSpinDate
        )
      ));
      // Admin-only "reset my wheel" testing tool deletes this doc so it
      // regenerates fresh on next load.
      allow delete: if isAdmin();
    }

    // ── Plinko ─────────────────────────────────────────────────────────────
    // Admin-managed config: enabled toggle (hidden behind admin while in dev).
    match /plinko_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-user plinko state — tracks the last free drop date, daily amber
    // earned, and star-bonus-claimed date. amberEarnedToday may only
    // increase when the amberEarnedDate stays the same (same day), or
    // reset freely when the date advances — prevents clients from writing
    // amberEarnedToday=0 to reset their own daily cap.
    match /plinko_state/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) &&
        request.resource.data.totalDrops == resource.data.get('totalDrops', 0) + 1 &&
        request.resource.data.lastDropDate >= resource.data.get('lastDropDate', '') &&
        (
          request.resource.data.get('amberEarnedDate', '') > resource.data.get('amberEarnedDate', '') ||
          request.resource.data.get('amberEarnedToday', 0) >= resource.data.get('amberEarnedToday', 0)
        );
      // Admin-only "reset my free ball" testing tool deletes this doc.
      allow delete: if isAdmin();
    }

    // ── TCG Dungeon Raid (admin-only while in dev) ────────────────────────────
    // Gate, party snapshot, and success/reward roll are all written client-side
    // at raid start (same trust model as Plinko/Wheel); claim deletes the doc
    // and grants amber via profiles.amber increment.
    match /raid_state/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // Tracks each player's progress through the daily 5-gate pool.
    match /dungeon_progress/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ── TCG Pack Store flash sale toggle ───────────────────────────────────
    match /tcg_sale_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── TCG card serial pools (global, transactionally updated on pack open) ──
    match /card_serials/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── TCG user binders ─────────────────────────────────────────────────────
    match /card_binders/{uid}/binders/{binder} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }

    // ── Cross-device game progress sync ──────────────────────────────────────
    match /game_progress/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // ── Username reservations (lowercase, normalized display names) ──────────
    match /usernames/{name} {
      allow read: if true;
      // Claiming a name: the doc must point to the requester's own uid.
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      // Releasing your old name (on rename): only the owner can delete.
      // resource is null if no reservation doc exists for the old name
      // (common for accounts created before this system existed) — allow
      // that no-op delete too.
      allow delete: if isAuth() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // ── Founders ─────────────────────────────────────────────────────────────
    match /founders/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── TCG Trade Bulletin ────────────────────────────────────────────────────
    match /auction_listings/{listingId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.uid;
      allow update: if isAdmin() || isAuth();
      allow delete: if isAdmin();
    }

    match /bulletin_listings/{listingId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.uid;
      allow update: if isAdmin() || (isAuth() && (
        request.auth.uid == resource.data.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingOfferCount'])
      ));
      allow delete: if isAdmin();
    }
    match /bulletin_offers/{offerId} {
      allow read: if isAdmin() || (isAuth() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.listingOwnerUid
      ));
      allow create: if isAuth() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.auth.uid != request.resource.data.listingOwnerUid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isAuth() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.listingOwnerUid
      ));
      allow delete: if isAdmin();
    }

    // ── TCG card trades ───────────────────────────────────────────────────────
    // Card transfers happen client-side: when a trade is accepted, each side's
    // own client deletes its given-up cards and recreates the received cards
    // (snapshotted in offerCards/requestCards at proposal time) in its own
    // card_collections subcollection — no cross-user writes needed.
    match /trades/{tradeId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid in resource.data.participants);
      allow create: if isAdmin() || (isAuth() && (
        (request.auth.uid in request.resource.data.participants &&
         request.resource.data.fromUid == request.auth.uid &&
         request.resource.data.toUid != request.auth.uid &&
         request.resource.data.status == 'pending') ||
        (request.auth.uid == request.resource.data.toUid &&
         request.auth.uid in request.resource.data.participants &&
         request.resource.data.status == 'completed' &&
         request.resource.data.source == 'bulletin')
      ));
      allow update: if isAdmin() || (isAuth() && request.auth.uid in resource.data.participants);
    }

    // ── TCG card trade locks ────────────────────────────────────────────────
    // When a trade is accepted, the accepting user claims a lock on each card
    // they're about to receive (doc id `{ownerUid}_{cardId}`). This stops the
    // same source card from being paid out by two different accepted trades
    // (e.g. a user sending two pending offers for the same card, both
    // accepted before the sender's client has removed the card). The owner
    // of the locked card removes the lock once their side of the trade is
    // applied.
    match /card_trade_locks/{lockId} {
      allow read: if true;
      // Users can only lock cards they own — prevents one user from blocking
      // another user's cards. The tradeId field identifies which trade holds
      // the lock; bulletin trades use a "bulletin_" prefix instead of a
      // trades-collection doc ID.
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuth();
    }
  }
}
