rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() { return isAuth() && request.auth.uid == 'XUD3ym2NcdWtrUiPLlFFaO5ufMh1'; }

    // ── Reviews ───────────────────────────────────────────────────────────────
    match /reviews/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Community content (likes/votes require update by any auth user) ───────
    match /tier_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /hot_takes/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /polls/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /brackets/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /bracket_templates/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /bw_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /bw_op_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    // ── BuzzWord game records & leaderboards ──────────────────────────────────
    match /bw_op_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_op_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_nrt_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_nrt_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_blc_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_blc_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_db_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_db_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /trivia_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /general_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    // ── Custom / Shared Lists ─────────────────────────────────────────────────
    match /custom_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      // Members can edit; anyone auth can join (their uid appears in new memberUids)
      allow update: if isAuth() && (
        resource.data.memberUids.hasAny([request.auth.uid]) ||
        request.resource.data.memberUids.hasAny([request.auth.uid])
      );
      allow delete: if isOwner(resource.data.uid);
    }

    match /melobee_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /patch_notes/{doc} {
      allow read: if true;
      // Posting/deleting official patch notes is admin-only (UI is gated by
      // window.isAdmin, but that's client-side only — enforce here too).
      // Likes/dislikes are toggled by any signed-in user via update.
      allow create, delete: if isAdmin();
      allow update: if isAuth();
    }

    // ── Comments ──────────────────────────────────────────────────────────────
    match /bw_post_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /episode_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /profile_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Profiles ──────────────────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      // Owner can update their own profile (display name, bio, avatar, etc.),
      // but privileged numeric fields (currency, rank counters) can only move
      // by small bounded amounts per write — matches the largest legitimate
      // single award (UR dismantle = 1500 amber) or spend (premium pack =
      // 1000 amber), and the +1 increments used for review/completion
      // counters. Prevents a client from setting these to arbitrary values.
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('amber', 0) >= resource.data.get('amber', 0) - 1000 &&
        request.resource.data.get('amber', 0) <= resource.data.get('amber', 0) + 2000 &&
        request.resource.data.get('reviewCount', 0)    <= resource.data.get('reviewCount', 0) + 1 &&
        request.resource.data.get('indepthCount', 0)   <= resource.data.get('indepthCount', 0) + 1 &&
        request.resource.data.get('completedCount', 0) <= resource.data.get('completedCount', 0) + 1 &&
        request.resource.data.get('reactionCount', 0)  <= resource.data.get('reactionCount', 0) + 1 &&
        request.resource.data.get('loginStreak', 0)    <= resource.data.get('loginStreak', 0) + 1
      );
    }

    // ── Anime lists & top lists ───────────────────────────────────────────────
    match /anime_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /top_anime_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Social (follows, friends, DMs) ───────────────────────────────────────
    match /follows/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /friends/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /friend_requests/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /conversations/{doc} {
      allow read: if isAuth() && (resource.data.participants[request.auth.uid] == true);
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.participants[request.auth.uid] == true);

      match /messages/{msg} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isOwner(resource.data.uid);
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{doc} {
      allow read: if isOwner(resource.data.targetUid);
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    // ── Achievements & ranks ──────────────────────────────────────────────────
    match /achievements/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /rankHistory/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Seasonal voting ───────────────────────────────────────────────────────
    match /seasonal_votes/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /seasonal_vote_records/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /seasonal_winners/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /seasonal_badges/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Cache & character DB ──────────────────────────────────────────────────
    match /anime_cache/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /characters/{doc} {
      allow read: if true;
      // Tier-list character search auto-caches new AniList results for any
      // signed-in user (always a brand-new doc), but editing or deleting
      // existing card art/rarities (TCG admin tools) is admin-only.
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ── Feedback ──────────────────────────────────────────────────────────────
    match /bug_reports/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /feature_suggestions/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /direct_suggestions/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── Amber currency log ───────────────────────────────────────────────────
    match /amber_log/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── TCG card collections (per-user subcollection) ─────────────────────────
    match /card_collections/{uid}/cards/{card} {
      allow read: if true;
      // Admin can also create cards directly in another user's collection —
      // used to gift the 1-of-1 Founder edition card.
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ── TCG card serial pools (global, transactionally updated on pack open) ──
    match /card_serials/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── TCG user binders ─────────────────────────────────────────────────────
    match /card_binders/{uid}/binders/{binder} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // ── Cross-device game progress sync ──────────────────────────────────────
    match /game_progress/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // ── Founders ─────────────────────────────────────────────────────────────
    match /founders/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
  }
}
