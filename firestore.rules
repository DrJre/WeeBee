rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // ── Reviews ───────────────────────────────────────────────────────────────
    match /reviews/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Community content (likes/votes require update by any auth user) ───────
    match /tier_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /hot_takes/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /polls/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /brackets/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /bracket_templates/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /bw_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /bw_op_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    // ── BuzzWord game records & leaderboards ──────────────────────────────────
    match /bw_op_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_op_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_nrt_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_nrt_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_blc_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_blc_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /bw_db_games/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isOwner(resource.data.uid);
    }
    match /bw_db_leaderboard/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /trivia_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /general_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    // ── Custom / Shared Lists ─────────────────────────────────────────────────
    match /custom_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      // Members can edit; anyone auth can join (their uid appears in new memberUids)
      allow update: if isAuth() && (
        resource.data.memberUids.hasAny([request.auth.uid]) ||
        request.resource.data.memberUids.hasAny([request.auth.uid])
      );
      allow delete: if isOwner(resource.data.uid);
    }

    match /melobee_posts/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isOwner(resource.data.uid);
    }

    match /patch_notes/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Comments ──────────────────────────────────────────────────────────────
    match /bw_post_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /episode_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /profile_comments/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Profiles ──────────────────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // ── Anime lists & top lists ───────────────────────────────────────────────
    match /anime_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /top_anime_lists/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ── Social (follows, friends, DMs) ───────────────────────────────────────
    match /follows/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /friends/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /friend_requests/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /conversations/{doc} {
      allow read: if isAuth() && (resource.data.participants[request.auth.uid] == true);
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.participants[request.auth.uid] == true);

      match /messages/{msg} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isOwner(resource.data.uid);
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{doc} {
      allow read: if isOwner(resource.data.targetUid);
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    // ── Achievements & ranks ──────────────────────────────────────────────────
    match /achievements/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /rankHistory/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Seasonal voting ───────────────────────────────────────────────────────
    match /seasonal_votes/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /seasonal_vote_records/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /seasonal_winners/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /seasonal_badges/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Cache & character DB ──────────────────────────────────────────────────
    match /anime_cache/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /characters/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Feedback ──────────────────────────────────────────────────────────────
    match /bug_reports/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /feature_suggestions/{doc} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /direct_suggestions/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── Amber currency log ───────────────────────────────────────────────────
    match /amber_log/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── TCG card collections (per-user subcollection) ─────────────────────────
    match /card_collections/{uid}/cards/{card} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ── TCG card serial pools (global, transactionally updated on pack open) ──
    match /card_serials/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── TCG user binders ─────────────────────────────────────────────────────
    match /card_binders/{uid}/binders/{binder} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // ── Cross-device game progress sync ──────────────────────────────────────
    match /game_progress/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // ── Founders ─────────────────────────────────────────────────────────────
    match /founders/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
  }
}
